10. Geek-onacci Number (GFG)

class Solution {

    public int geekonacci(int a, int b, int c, int n) {

        if (n == 1)
            return a;

        if (n == 2)
            return b;

        if (n == 3)
            return c;

        return geekonacci(a, b, c, n - 1)
                + geekonacci(a, b, c, n - 2)
                + geekonacci(a, b, c, n - 3);
    }
}


