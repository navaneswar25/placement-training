import java.util.*;

class Solution {

    ArrayList<Integer> increasingNumbers(int N) {

        ArrayList<Integer> ans = new ArrayList<>();

        if (N == 1)
            ans.add(0);

        generate(N, 1, "", ans);

        return ans;
    }

    void generate(int n, int digit, String s, ArrayList<Integer> ans) {

        if (s.length() == n) {
            ans.add(Integer.parseInt(s));
            return;
        }

        for (int i = digit; i <= 9; i++)
            generate(n, i + 1, s + i, ans);
    }
}


8. Pow(x, n) (LeetCode)

Question:
Implement pow(x, n) which calculates x raised to the power n.

class Solution {

    public double myPow(double x, int n) {

        long N = n;

        if (N < 0) {
            x = 1 / x;
            N = -N;
        }

        return power(x, N);
    }

    private double power(double x, long n) {

        if (n == 0)
            return 1;

        double half = power(x, n / 2);

        if (n % 2 == 0)
            return half * half;

        return half * half * x;
    }
}


9. Minimum Non-Zero Product of the Array Elements (LeetCode)

class Solution {

    long MOD = 1000000007;

    public int minNonZeroProduct(int p) {

        long max = (1L << p) - 1;
        long second = max - 1;
        long times = (1L << (p - 1)) - 1;

        return (int) ((power(second, times) * max) % MOD);
    }

    private long power(long a, long b) {

        if (b == 0)
            return 1;

        long half = power(a, b / 2);

        long ans = (half * half) % MOD;

        if (b % 2 == 1)
            ans = (ans * a) % MOD;

        return ans;
    }
}


10. Handshakes (GFG)

class Solution {

    static long[] dp = new long[101];

    static long count(int n) {

        if (n <= 1)
            return 1;

        if (dp[n] != 0)
            return dp[n];

        long ans = 0;

        for (int i = 0; i < n; i++)
            ans += count(i) * count(n - i - 1);

        return dp[n] = ans;
    }
}


11. Divisible Subset (CodeChef)

import java.util.*;

class Solution {

    public List<Integer> largestDivisibleSubset(int[] nums) {

        Arrays.sort(nums);

        int n = nums.length;
        int[] dp = new int[n];
        int[] prev = new int[n];

        Arrays.fill(dp, 1);
        Arrays.fill(prev, -1);

        int max = 1;
        int index = 0;

        for (int i = 1; i < n; i++) {

            for (int j = 0; j < i; j++) {

                if (nums[i] % nums[j] == 0 && dp[j] + 1 > dp[i]) {
                    dp[i] = dp[j] + 1;
                    prev[i] = j;
                }
            }

            if (dp[i] > max) {
                max = dp[i];
                index = i;
            }
        }

        List<Integer> ans = new ArrayList<>();

        while (index != -1) {
            ans.add(nums[index]);
            index = prev[index];
        }

        Collections.reverse(ans);

        return ans;
    }
}


12. Perfect Squares (LeetCode)

import java.util.*;

class Solution {

    public int numSquares(int n) {

        int[] dp = new int[n + 1];

        Arrays.fill(dp, Integer.MAX_VALUE);

        dp[0] = 0;

        for (int i = 1; i <= n; i++) {

            for (int j = 1; j * j <= i; j++)
                dp[i] = Math.min(dp[i], dp[i - j * j] + 1);
        }

        return dp[n];
    }
}


13. Decode String (LeetCode)

import java.util.*;

class Solution {

    public String decodeString(String s) {

        Stack<Integer> count = new Stack<>();
        Stack<StringBuilder> result = new Stack<>();

        StringBuilder curr = new StringBuilder();
        int num = 0;

        for (char ch : s.toCharArray()) {

            if (Character.isDigit(ch)) {

                num = num * 10 + ch - '0';

            } else if (ch == '[') {

                count.push(num);
                result.push(curr);

                curr = new StringBuilder();
                num = 0;

            } else if (ch == ']') {

                StringBuilder temp = result.pop();

                int times = count.pop();

                while (times-- > 0)
                    temp.append(curr);

                curr = temp;

            } else {

                curr.append(ch);
            }
        }

        return curr.toString();
    }
}


