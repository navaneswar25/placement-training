1. Minimum Number of Flips to Convert Binary Matrix to Zero Matrix (LeetCode 1284)

import java.util.*;

class Solution {

    int[][] dir = {{0,0},{1,0},{-1,0},{0,1},{0,-1}};

    public int minFlips(int[][] mat) {

        int m = mat.length;
        int n = mat[0].length;

        int start = 0;

        for(int i=0;i<m;i++){
            for(int j=0;j<n;j++){
                if(mat[i][j]==1)
                    start |= 1<<(i*n+j);
            }
        }

        Queue<Integer> q = new LinkedList<>();
        Set<Integer> vis = new HashSet<>();

        q.offer(start);
        vis.add(start);

        int steps = 0;

        while(!q.isEmpty()){

            int size = q.size();

            while(size-- > 0){

                int state = q.poll();

                if(state==0)
                    return steps;

                for(int i=0;i<m;i++){

                    for(int j=0;j<n;j++){

                        int next = state;

                        for(int[] d:dir){

                            int r=i+d[0];
                            int c=j+d[1];

                            if(r>=0 && r<m && c>=0 && c<n){
                                next ^= 1<<(r*n+c);
                            }
                        }

                        if(!vis.contains(next)){
                            vis.add(next);
                            q.offer(next);
                        }
                    }
                }
            }

            steps++;
        }

        return -1;
    }
}


2. Minimum Cost to Connect Two Groups of Points (LeetCode 1595)

import java.util.*;

class Solution {

    int[][] dp;

    public int connectTwoGroups(List<List<Integer>> cost) {

        int m = cost.size();
        int n = cost.get(0).size();

        dp = new int[m][1<<n];

        for(int[] row:dp)
            Arrays.fill(row,-1);

        int[] minCost = new int[n];

        Arrays.fill(minCost,Integer.MAX_VALUE);

        for(int j=0;j<n;j++)
            for(int i=0;i<m;i++)
                minCost[j]=Math.min(minCost[j],cost.get(i).get(j));

        return dfs(0,0,cost,minCost);
    }

    private int dfs(int i,int mask,List<List<Integer>> cost,int[] minCost){

        int m = cost.size();
        int n = cost.get(0).size();

        if(i==m){

            int ans=0;

            for(int j=0;j<n;j++){
                if((mask&(1<<j))==0)
                    ans+=minCost[j];
            }

            return ans;
        }

        if(dp[i][mask]!=-1)
            return dp[i][mask];

        int ans=Integer.MAX_VALUE;

        for(int j=0;j<n;j++){

            ans=Math.min(ans,
                    cost.get(i).get(j)+
                    dfs(i+1,mask|(1<<j),cost,minCost));
        }

        return dp[i][mask]=ans;
    }
}
