1. Longest Valid Parentheses (LeetCode)

import java.util.*;

class Solution {

    public int longestValidParentheses(String s) {

        Stack<Integer> stack = new Stack<>();
        stack.push(-1);

        int max = 0;

        for (int i = 0; i < s.length(); i++) {

            if (s.charAt(i) == '(') {

                stack.push(i);

            } else {

                stack.pop();

                if (stack.isEmpty()) {
                    stack.push(i);
                } else {
                    max = Math.max(max, i - stack.peek());
                }
            }
        }

        return max;
    }
}


2. Sliding Window Maximum (LeetCode)

import java.util.*;

class Solution {

    public int[] maxSlidingWindow(int[] nums, int k) {

        Deque<Integer> deque = new LinkedList<>();
        int[] ans = new int[nums.length - k + 1];

        int idx = 0;

        for (int i = 0; i < nums.length; i++) {

            while (!deque.isEmpty() && deque.peekFirst() <= i - k)
                deque.pollFirst();

            while (!deque.isEmpty() && nums[deque.peekLast()] <= nums[i])
                deque.pollLast();

            deque.offerLast(i);

            if (i >= k - 1)
                ans[idx++] = nums[deque.peekFirst()];
        }

        return ans;
    }
}


3. Brace Expansion II (LeetCode)

import java.util.*;

class Solution {

    int i = 0;

    public List<String> braceExpansionII(String expression) {

        Set<String> result = parse(expression);
        List<String> ans = new ArrayList<>(result);
        Collections.sort(ans);

        return ans;
    }

    private Set<String> parse(String s) {

        Set<String> res = new TreeSet<>();
        Set<String> cur = new TreeSet<>();
        cur.add("");

        while (i < s.length() && s.charAt(i) != '}') {

            char ch = s.charAt(i);

            if (ch == '{') {

                i++;
                Set<String> temp = parse(s);

                Set<String> next = new TreeSet<>();

                for (String a : cur)
                    for (String b : temp)
                        next.add(a + b);

                cur = next;

            } else if (Character.isLetter(ch)) {

                Set<String> next = new TreeSet<>();

                for (String a : cur)
                    next.add(a + ch);

                cur = next;

            } else if (ch == ',') {

                res.addAll(cur);
                cur = new TreeSet<>();
                cur.add("");
            }

            i++;
        }

        res.addAll(cur);
        return res;
    }
}
