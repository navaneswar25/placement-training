1. Roman to Integer (LeetCode)

class Solution {

    public int romanToInt(String s) {

        int ans = 0;

        for (int i = 0; i < s.length(); i++) {

            int val = value(s.charAt(i));

            if (i < s.length() - 1 && val < value(s.charAt(i + 1)))
                ans -= val;
            else
                ans += val;
        }

        return ans;
    }

    private int value(char c) {

        switch (c) {
            case 'I': return 1;
            case 'V': return 5;
            case 'X': return 10;
            case 'L': return 50;
            case 'C': return 100;
            case 'D': return 500;
            case 'M': return 1000;
        }

        return 0;
    }
}


2. Happy Number (LeetCode)

import java.util.*;

class Solution {

    public boolean isHappy(int n) {

        HashSet<Integer> set = new HashSet<>();

        while (n != 1 && !set.contains(n)) {

            set.add(n);

            int sum = 0;

            while (n > 0) {
                int d = n % 10;
                sum += d * d;
                n /= 10;
            }

            n = sum;
        }

        return n == 1;
    }
}


3. Armstrong Number

class Solution {

    public boolean isArmstrong(int n) {

        int temp = n;
        int digits = String.valueOf(n).length();

        int sum = 0;

        while (temp > 0) {

            int d = temp % 10;
            sum += Math.pow(d, digits);
            temp /= 10;
        }

        return sum == n;
    }
}


4. Power of Four (LeetCode)

class Solution {

    public boolean isPowerOfFour(int n) {

        return n > 0 &&
               (n & (n - 1)) == 0 &&
               (n & 0x55555555) != 0;
    }
}


5. Factorial

class Solution {

    public long factorial(int n) {

        long fact = 1;

        for (int i = 2; i <= n; i++)
            fact *= i;

        return fact;
    }
}


6. Excel Sheet Column Number (LeetCode)

class Solution {

    public int titleToNumber(String columnTitle) {

        int ans = 0;

        for (char ch : columnTitle.toCharArray()) {
            ans = ans * 26 + (ch - 'A' + 1);
        }

        return ans;
    }
}


